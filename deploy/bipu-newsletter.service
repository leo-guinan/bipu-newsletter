[Unit]
Description=BIPU Newsletter Event Ledger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bipu-newsletter
Group=bipu-newsletter
WorkingDirectory=/opt/bipu-newsletter
EnvironmentFile=/etc/bipu-newsletter/newsletter.env
ExecStart=/usr/bin/python3 -m bipu_newsletter.server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bipu-newsletter

[Install]
WantedBy=multi-user.target
